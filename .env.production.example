# Боевой .env для docker-compose.prod.yml. На сервере: cp .env.production.example .env
# Секреты генерировать так (только буквы и цифры — их можно вставлять в URL):
#   openssl rand -hex 32

# --- Домен ---
# Домен без https://, A-запись должна указывать на сервер (порты 80 и 443 открыты).
DOMAIN=
# Почта для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=

# --- Telegram ---
BOT_TOKEN=
# Username бота без @
BOT_USERNAME=
# Short name Mini App из @BotFather /newapp; URL Mini App в BotFather: https://<DOMAIN>
MINIAPP_SHORT_NAME=
# 16–256 символов A-Z a-z 0-9 _ -
BOT_WEBHOOK_SECRET=

# --- Секреты приложения ---
# Не короче 32 символов
JWT_SECRET=
INTERNAL_TOKEN=
POSTGRES_PASSWORD=

# --- Фото (S3) ---
# По умолчанию — встроенный MinIO; ключи задаёте сами.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Внешнее S3-хранилище вместо MinIO:
# S3_ENDPOINT=https://s3.example.kz
# S3_REGION=
# S3_BUCKET=standup
# S3_PUBLIC_URL=https://standup.s3.example.kz
# S3_CREATE_BUCKET=false

LOG_LEVEL=info

# --- Бэкапы (deploy/backup.sh) ---
# BACKUP_DIR=/var/backups/standup
# BACKUP_KEEP_DAYS=14
