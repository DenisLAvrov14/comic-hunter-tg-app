# Скопируйте в .env. docker compose подхватывает .env автоматически,
# локальный `pnpm dev` — через --env-file-if-exists.

NODE_ENV=development
LOG_LEVEL=info

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Username бота без @
BOT_USERNAME=
# Short name Mini App из BotFather /newapp (для ссылок t.me/<bot>/<app>?startapp=...)
MINIAPP_SHORT_NAME=
# Публичный https-адрес Mini App (в dev — туннель на :8080, например cloudflared/ngrok)
MINIAPP_URL=
# polling (dev) | webhook (prod)
BOT_MODE=polling
BOT_WEBHOOK_PORT=3001
BOT_WEBHOOK_SECRET=

# --- API ---
API_PORT=3000
# Общий секрет бота и API: кнопки в сообщениях бота выполняются через API от имени пользователя
INTERNAL_TOKEN=dev-internal-token
# Адрес API для бота (в docker compose задаётся сам: http://api:3000)
API_INTERNAL_URL=http://localhost:3000
# Период планировщика уведомлений в worker, мс (по ТЗ — раз в минуту)
SCHEDULER_TICK_MS=60000
# Не короче 32 символов
JWT_SECRET=dev-secret-change-me-dev-secret-change-me
# Вход по telegram_id без подписи. В production приложение не стартует с true.
DEV_AUTH=true
# Публичный адрес API (ссылки на ICS и т.п.)
PUBLIC_BASE_URL=http://localhost:8080

# --- Хранилища (для локального запуска вне docker) ---
DATABASE_URL=postgres://standup:standup@localhost:5442/standup
# Для интеграционных тестов (pnpm test); без него они пропускаются
TEST_DATABASE_URL=postgres://standup:standup@localhost:5442/standup
REDIS_URL=redis://localhost:6379

# --- S3 (в dev — MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=standup
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Фото отдаются через прокси Mini App (vite / nginx): /media → MinIO
S3_PUBLIC_URL=/media
# Создать бакет и открыть photos/ на чтение при старте API (только dev)
S3_CREATE_BUCKET=true
